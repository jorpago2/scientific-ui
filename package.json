{
  "name": "@jorpago2/scientific-ui",
  "version": "0.3.5",
  "description": "Carbon-based workbench components for scientific web applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorpago2/scientific-ui.git"
  },
  "homepage": "https://github.com/jorpago2/scientific-ui#readme",
  "bugs": {
    "url": "https://github.com/jorpago2/scientific-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./tokens.css"
  ],
  "files": [
    "dist",
    "tokens.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@carbon/react": "1.113.x",
    "react": "19.2.x",
    "react-dom": "19.2.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@carbon/react": "1.113.0",
    "@changesets/cli": "2.29.7",
    "@ibm/plex": "6.4.1",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "10.5.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "sass": "1.102.0",
    "storybook": "10.5.7",
    "typescript": "6.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
